from dotenv import load_dotenv
import os
import mysql.connector
import hashlib
import logging

# Carrega automaticamente o arquivo .env (na raiz do projeto)
load_dotenv()

# Conexão com o banco MariaDB usando variáveis de ambiente
def get_db_connection():
    try:
        return mysql.connector.connect(
            host=os.getenv("DB_HOST"),
            port=int(os.getenv("DB_PORT", 3306)),
            user=os.getenv("DB_USER"),
            password=os.getenv("DB_PASSWORD"),
            database=os.getenv("DB_NAME"),
        )
    except mysql.connector.Error as e:
        logging.error(f"erro_conexao_banco: {e}")
        return None


# Função para verificar as credenciais do usuário
def verify_credential(email, senha):
    connection = get_db_connection()
    
    if not connection:
        logging.error("conexao_banco_indisponivel")
        return False

    try:
        cursor = connection.cursor()
        query = "SELECT user_password FROM tbUser WHERE user_email = %s"
        cursor.execute(query, (email,))
        result = cursor.fetchone()

        if result:
            hashed_senha_db = result[0]
            hashed_senha_digitada = hashlib.sha256(senha.encode()).hexdigest()
            return hashed_senha_digitada == hashed_senha_db

        return False

    except mysql.connector.Error as e:
        logging.error(f"erro_query_usuario: {e}")
        return False

    finally:
        cursor.close()
        connection.close()